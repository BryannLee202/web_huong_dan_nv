GMAIL_APP_PASSWORD=

# -------------------------------------------------------------------------
# 2. CẤU HÌNH ĐĂNG NHẬP GOOGLE OAUTH 2.0 THẬT 100% (GOOGLE SIGN-IN)
# -------------------------------------------------------------------------
# - GOOGLE_CLIENT_ID: Mã Client ID OAuth 2.0 tạo từ Google Cloud Console
#   (Tạo tại: https://console.cloud.google.com/apis/credentials)
#   (Dạng: xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

# -------------------------------------------------------------------------
# 3. GOOGLE GEMINI 2.5 FLASH AI ENGINE (SIÊU TRÍ TUỆ NHÂN TẠO DEEPMIND)
# -------------------------------------------------------------------------
# - GEMINI_API_KEY: Khóa API lấy miễn phí 100% tại https://aistudio.google.com/app/apikey

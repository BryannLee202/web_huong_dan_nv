PORT=5000

# Khóa bí mật đăng ký tài khoản Quản trị / Chủ Doanh Nghiệp (chỉ cấp cho Anh Rin & Quản lý)
ADMIN_SECRET_KEY=RIN-2005

# -------------------------------------------------------------------------
# 1. CẤU HÌNH GỬI EMAIL OTP THẬT QUA GMAIL (SMTP THẬT 100%)
# -------------------------------------------------------------------------
# - GMAIL_USER: Địa chỉ Gmail của bạn (VD: hotro.runningman@gmail.com)
# - GMAIL_APP_PASSWORD: Mật khẩu ứng dụng 16 chữ số do Google cấp
#   (Lấy tại: https://myaccount.google.com/apppasswords sau khi bật Xác minh 2 bước)
# (Lưu ý: Nếu để trống, hệ thống tự động in mã OTP ra Terminal/Console và UI để test tiện lợi)
